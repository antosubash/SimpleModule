<Project>
  <!-- Resolve the npm workspace root. In the monorepo, RepoRoot is supplied by
       Directory.Build.props. In a downstream consumer that references the
       SimpleModule.Hosting NuGet package, RepoRoot is undefined, so fall back to the
       nearest ancestor directory containing package.json (the npm workspace root where
       node_modules is installed). -->
  <PropertyGroup>
    <RepoRoot Condition="'$(RepoRoot)' == ''"
      >$([MSBuild]::EnsureTrailingSlash($([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'package.json'))))</RepoRoot
    >
  </PropertyGroup>
  <!-- Frontend build-integration paths. Defaults target a consumer scaffold layout
       (theme from the @simplemodule/theme-default npm package, modules under src/modules,
       routes emitted into the host's ClientApp). The monorepo overrides these in its
       Directory.Build.props to point at the in-repo packages/ and modules/ folders. -->
  <PropertyGroup>
    <SimpleModuleThemeCss Condition="'$(SimpleModuleThemeCss)' == ''"
      >$(RepoRoot)node_modules/@simplemodule/theme-default/theme.css</SimpleModuleThemeCss
    >
    <SimpleModuleModulesDir Condition="'$(SimpleModuleModulesDir)' == ''"
      >$(RepoRoot)src/modules</SimpleModuleModulesDir
    >
    <SimpleModuleRoutesOutput Condition="'$(SimpleModuleRoutesOutput)' == ''"
      >$(MSBuildProjectDirectory)/ClientApp/routes.ts</SimpleModuleRoutesOutput
    >
  </PropertyGroup>
  <!-- Build configuration -->
  <PropertyGroup>
    <TailwindCli Condition="'$(OS)' == 'Windows_NT'"
      >$(RepoRoot)node_modules/.bin/tailwindcss.cmd</TailwindCli
    >
    <TailwindCli Condition="'$(OS)' != 'Windows_NT'"
      >$(RepoRoot)node_modules/.bin/tailwindcss</TailwindCli
    >
    <TailwindInput>$(MSBuildProjectDirectory)/Styles/app.css</TailwindInput>
    <TailwindOutput>$(MSBuildProjectDirectory)/wwwroot/css/app.css</TailwindOutput>
    <ViteBuildStamp>$(IntermediateOutputPath)vitebuild.stamp</ViteBuildStamp>
    <ExtractDtoStamp>$(IntermediateOutputPath)extractdto.stamp</ExtractDtoStamp>
    <ExtractRoutesStamp>$(IntermediateOutputPath)extractroutes.stamp</ExtractRoutesStamp>
  </PropertyGroup>
  <!-- Incremental Tailwind: the up-to-date check has to see every file Tailwind
       scans, not just the stylesheets. Styles/app.css declares the module pages as
       @source globs, so unless those pages are inputs here, adding or editing one
       leaves the compiled CSS untouched and its utility classes are silently never
       generated (#288). Hosts with extra @source directives of their own can add to
       @(TailwindExtraSourceFiles). -->
  <ItemGroup Condition="Exists('$(TailwindInput)')">
    <TailwindSourceFiles
      Include="$(MSBuildProjectDirectory)/Styles/**/*.css"
      Exclude="$(MSBuildProjectDirectory)/Styles/_scan/**"
    />
    <TailwindSourceFiles Include="$(SimpleModuleThemeCss)" Condition="Exists('$(SimpleModuleThemeCss)')" />
    <TailwindSourceFiles
      Include="$(SimpleModuleModulesDir)/**/Pages/**/*.tsx;$(SimpleModuleModulesDir)/**/Views/**/*.tsx"
      Exclude="$(SimpleModuleModulesDir)/**/node_modules/**"
      Condition="Exists('$(SimpleModuleModulesDir)')"
    />
    <TailwindSourceFiles
      Include="$(MSBuildProjectDirectory)/ClientApp/**/*.tsx"
      Exclude="$(MSBuildProjectDirectory)/ClientApp/node_modules/**"
      Condition="Exists('$(MSBuildProjectDirectory)/ClientApp')"
    />
    <!-- Module bundles staged by CollectModuleAssets and scanned via @source "./_scan/",
         which is how a packaged module's classes reach the CSS. -->
    <TailwindSourceFiles Include="$(MSBuildProjectDirectory)/Styles/_scan/**/*.js" />
  </ItemGroup>
  <!-- Incremental Vite: track ClientApp source files -->
  <ItemGroup Condition="Exists('ClientApp/package.json') And (Exists('ClientApp/node_modules') Or Exists('$(RepoRoot)node_modules'))">
    <ViteSourceFiles Include="$(MSBuildProjectDirectory)/ClientApp/**/*.ts;$(MSBuildProjectDirectory)/ClientApp/**/*.tsx" />
    <ViteSourceFiles Include="$(MSBuildProjectDirectory)/ClientApp/package.json" />
  </ItemGroup>
  <!-- Collect module .pages.js assets for Tailwind CSS scanning -->
  <Target
    Name="CollectModuleAssets"
    BeforeTargets="TailwindBuild"
    DependsOnTargets="ResolveStaticWebAssetsConfiguration"
  >
    <ItemGroup>
      <_ModulePages
        Include="@(StaticWebAsset)"
        Condition="$([System.String]::Copy('%(Identity)').EndsWith('.pages.js'))"
      />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)/Styles/_scan" />
    <Copy
      SourceFiles="@(_ModulePages)"
      DestinationFolder="$(MSBuildProjectDirectory)/Styles/_scan/"
      SkipUnchangedFiles="true"
    />
  </Target>
  <!-- Warn when Tailwind input exists but node_modules is missing -->
  <Target
    Name="TailwindBuildCheck"
    BeforeTargets="Build"
    Condition="Exists('$(TailwindInput)') And !Exists('$(RepoRoot)node_modules')"
  >
    <Warning Text="node_modules not found. Tailwind CSS will not be compiled. Run 'npm install' in the repository root." />
  </Target>
  <!-- Tailwind CSS build (incremental: real output file as Outputs) -->
  <Target
    Name="TailwindBuild"
    BeforeTargets="Build"
    Condition="Exists('$(TailwindInput)') And Exists('$(RepoRoot)node_modules')"
    Inputs="@(TailwindSourceFiles);@(TailwindExtraSourceFiles)"
    Outputs="$(TailwindOutput)"
  >
    <Exec Command="&quot;$(TailwindCli)&quot; -i &quot;$(TailwindInput)&quot; -o &quot;$(TailwindOutput)&quot; --minify" />
  </Target>
  <!-- Warn when ClientApp exists but node_modules is missing -->
  <Target
    Name="ViteBuildCheck"
    BeforeTargets="Build"
    Condition="Exists('ClientApp/package.json') And !Exists('ClientApp/node_modules') And !Exists('$(RepoRoot)node_modules')"
  >
    <Warning Text="node_modules not found. Frontend JavaScript will not be compiled. Run 'npm install' in the repository root." />
  </Target>
  <!-- Vite: Build React host app (incremental via stamp file) -->
  <Target
    Name="ViteBuild"
    BeforeTargets="Build"
    Condition="Exists('ClientApp/package.json') And (Exists('ClientApp/node_modules') Or Exists('$(RepoRoot)node_modules'))"
    Inputs="@(ViteSourceFiles)"
    Outputs="$(ViteBuildStamp)"
  >
    <Exec
      Command="npx vite build --configLoader runner"
      WorkingDirectory="$(MSBuildProjectDirectory)/ClientApp"
    />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Touch Files="$(ViteBuildStamp)" AlwaysCreate="true" />
  </Target>
  <!-- Extract TypeScript type definitions from source generator output (incremental via stamp file) -->
  <Target
    Name="ExtractDtoTypeScript"
    AfterTargets="CoreCompile"
    Condition="Exists('$(RepoRoot)scripts/extract-ts-types.mjs')"
    Inputs="$(IntermediateOutputPath)generated/SimpleModule.Generator/SimpleModule.Generator.ModuleDiscovererGenerator/**/*"
    Outputs="$(ExtractDtoStamp)"
  >
    <Exec
      Command="node &quot;$(RepoRoot)scripts/extract-ts-types.mjs&quot; &quot;$(IntermediateOutputPath)generated/SimpleModule.Generator/SimpleModule.Generator.ModuleDiscovererGenerator&quot; &quot;$(SimpleModuleModulesDir)&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)"
    />
    <Touch Files="$(ExtractDtoStamp)" AlwaysCreate="true" />
  </Target>
  <!-- Extract TypeScript route definitions from source generator output (incremental via stamp file) -->
  <Target
    Name="ExtractRoutes"
    AfterTargets="CoreCompile"
    Condition="Exists('$(RepoRoot)scripts/extract-routes.mjs')"
    Inputs="$(IntermediateOutputPath)generated/SimpleModule.Generator/SimpleModule.Generator.ModuleDiscovererGenerator/**/*"
    Outputs="$(ExtractRoutesStamp)"
  >
    <Exec
      Command="node &quot;$(RepoRoot)scripts/extract-routes.mjs&quot; &quot;$(IntermediateOutputPath)generated/SimpleModule.Generator/SimpleModule.Generator.ModuleDiscovererGenerator&quot; &quot;$(SimpleModuleRoutesOutput)&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)"
    />
    <Touch Files="$(ExtractRoutesStamp)" AlwaysCreate="true" />
  </Target>
</Project>
